NODE_ENV=development
PORT=4000
HOST=127.0.0.1
WEB_PORT=5173
APP_URL=http://localhost:5173
# Local demo accounts and verification codes are NEVER enabled in production.
DEMO_MODE=true
SESSION_SECRET=replace-with-at-least-32-random-characters
SQLITE_PATH=./data/partnerhub.sqlite
# Set DATABASE_URL to use PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql://partnerhub:change-me@localhost:5432/partnerhub
# DATABASE_SSL=true
UPLOAD_DIR=./uploads
# Only enable this when your reverse proxy is trusted and strips client X-Forwarded-* headers.
TRUST_PROXY=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=VS PartnerHub <partners@example.com>
# Bootstrap with npm run admin:create. Never use demo credentials in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator
# Docker Compose only: use a long random hexadecimal database password.
# POSTGRES_PASSWORD=
