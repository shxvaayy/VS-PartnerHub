NODE_ENV=development
PORT=4000
HOST=127.0.0.1
WEB_PORT=5173
APP_URL=http://localhost:5173
# A normal workspace starts empty. Test fixtures require explicit opt-in and a separate database.
DEMO_MODE=false
SESSION_SECRET=replace-with-at-least-32-random-characters
# Use another independent random secret and retain it with encrypted database backups.
INTEGRATION_ENCRYPTION_KEY=
SQLITE_PATH=./data/workspace.sqlite
UPLOAD_DIR=./uploads/workspace
# Set DATABASE_URL to use PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql://partnerhub:password@localhost:5432/partnerhub
# DATABASE_SSL=true
# Enable only behind a trusted proxy that replaces X-Forwarded-* headers.
TRUST_PROXY=0

# Set provider credentials here OR through Super Admin > Integrations.
# MAIL_FROM must be a sender authorized by your email provider.
MAIL_FROM=
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Google Gemini is the only AI provider. Credentials are server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_USER_LIMIT=100

# First admin: /setup on this computer, or npm run admin:create.
# Production web setup requires a unique token of at least 32 characters.
SETUP_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Docker Compose database password (use a long random hexadecimal value).
POSTGRES_PASSWORD=
# Optional server-admin allowlist for private HTTPS ERP webhook hosts.
WEBHOOK_ALLOWED_PRIVATE_HOSTS=

# Native sync requires your deployed HTTPS origin. Never bundle provider secrets.
MOBILE_SERVER_URL=
MOBILE_DEV=false
